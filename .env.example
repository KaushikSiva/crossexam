# Set real, credited provider keys locally. Never commit .env.
MODEL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
SUBQ_API_KEY=
META_MODEL=muse-spark-1.3
SUBQ_MODEL=subq-snap-1.1

# Google DeepMind / Gemini (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fetch.ai / ASI:One (ASI1_API_KEY is also accepted)
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini

# Optional evidence archive; enable explicitly with --mongo or the UI checkbox.
# Install the driver with: pip install -r requirements-mongodb.txt
MONGODB_URI=
MONGODB_DATABASE=crossexam

# Optional stable Fetch verification-agent identity; otherwise generated locally
# in the gitignored runs/fetch-agent/identity.seed. Never publish this seed.
FETCH_AGENT_SEED=

# Optional narrated demo generation: ElevenLabs V4 with the premade Brian voice
ELEVENLABS_API_KEY=
