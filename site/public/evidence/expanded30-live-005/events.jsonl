{"sequence": 5, "timestamp": "2026-11-08T00:14:07.784358+00:00", "kind": "counterexample", "message": "M01: existing tests pass; contract fails", "data": {"id": "M01", "title": "Idempotency cache drops tenant from the namespace, keying replays on key alone", "family": "tenant_isolation", "origin": "live Fetch.ai / ASI:One", "baseline_passed": true, "baseline_checks": 4, "witness": {"name": "same key, different customers", "family": "tenant_isolation", "passed": false, "actions": [{"op": "reserve", "tenant": "atlas", "key": "order-1", "sku": "widget", "qty": 2}, {"op": "reserve", "tenant": "beacon", "key": "order-1", "sku": "widget", "qty": 2}], "expected": [{"status": "reserved", "tenant": "atlas", "key": "order-1", "sku": "widget", "qty": 2}, {"status": "reserved", "tenant": "beacon", "key": "order-1", "sku": "widget", "qty": 2}], "actual": [{"status": "reserved", "tenant": "atlas", "key": "order-1", "sku": "widget", "qty": 2}, {"status": "reserved", "tenant": "atlas", "key": "order-1", "sku": "widget", "qty": 2}]}, "diff": "--- a/cache.py\n+++ b/cache.py\n@@ -1,8 +1,13 @@\n-\"\"\"Idempotency storage; tenant identity is part of the namespace.\"\"\"\n+\"\"\"Idempotency storage; flat key index for fast replay lookups.\"\"\"\n+\n+# Optimization: reservation keys are unique across the deployment, so the\n+# cache is indexed by the key string alone. This avoids building a tuple\n+# per lookup and keeps the index compact; the tenant argument is kept for\n+# interface compatibility with Service.\n \n \n def cache_key(tenant, key):\n-    return (tenant, key)\n+    return key\n \n \n class ReplayCache:", "source_sha256": "270e018e37a17ba237cd00e47edac0a9ba01b5a5a8c7d20463ab46a05dde6f57"}, "previous": "8d597655fb595bc39d4733e8c253752dc59c3ca9d990b7c5b3ef5cc74a54c6a0", "sha256": "4b11202ecc493599ede4616289b4504470865009c8285e37846ce92466ebbd75"}
