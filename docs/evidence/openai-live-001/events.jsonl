{"sequence": 5, "timestamp": "2026-11-07T22:38:55.319734+00:00", "kind": "counterexample", "message": "M01: existing tests pass; contract fails", "data": {"id": "M01", "title": "Optimize inventory lookup by collapsing tenant dimension", "family": "tenant_isolation", "origin": "live OpenAI", "baseline_passed": true, "baseline_checks": 4, "witness": {"name": "same key, different customers", "family": "tenant_isolation", "passed": false, "actions": [{"op": "reserve", "tenant": "beacon", "key": "order-1", "sku": "widget", "qty": 2}, {"op": "stock", "tenant": "atlas", "sku": "widget"}], "expected": [{"status": "reserved", "tenant": "beacon", "key": "order-1", "sku": "widget", "qty": 2}, {"available": 10}], "actual": [{"status": "reserved", "tenant": "beacon", "key": "order-1", "sku": "widget", "qty": 2}, {"available": 8}]}, "diff": "--- a/service.py\n+++ b/service.py\n@@ -5,6 +5,8 @@\n \n class Service:\n     def __init__(self):\n+        # Optimization: inventory is tracked per SKU only, while idempotency keeps the tenant/key tuple.\n+        # This is sufficient for sequential single-tenant scenarios and reduces state fanout.\n         self.stock = {}\n         self.cache = ReplayCache()\n \n@@ -19,7 +21,7 @@\n         if op == \"stock\":\n             if sku not in (\"widget\", \"sensor\"):\n                 return {\"error\": \"invalid\"}\n-            return {\"available\": self.stock.get((tenant, sku), 10)}\n+            return {\"available\": self.stock.get(sku, 10)}\n         if op not in (\"reserve\", \"release\") or not isinstance(key, str) or not key:\n             return {\"error\": \"invalid\"}\n         if op == \"release\":\n@@ -27,8 +29,7 @@\n             if record is None:\n                 return {\"error\": \"not_found\"}\n             if not record[\"released\"]:\n-                slot = (tenant, record[\"sku\"])\n-                self.stock[slot] = self.stock.get(slot, 10) + record[\"qty\"]\n+                self.stock[record[\"sku\"]] = self.stock.get(record[\"sku\"], 10) + record[\"qty\"]\n                 record[\"released\"] = True\n             return {\"status\": \"released\", \"tenant\": tenant, \"key\": key}\n         if sku not in (\"widget\", \"sensor\") or type(qty) is not int or not 1 <= qty <= 10:\n@@ -38,11 +39,10 @@\n             if record[\"sku\"] != sku or record[\"qty\"] != qty:\n                 return {\"error\": \"conflict\"}\n             return record[\"response\"].copy()\n-        slot = (tenant, sku)\n-        available = self.stock.get(slot, 10)\n+        available = self.stock.get(sku, 10)\n         if available < qty:\n             return {\"error\": \"insufficient\"}\n-        self.stock[slot] = available - qty\n+        self.stock[sku] = available - qty\n         response = {\"status\": \"reserved\", \"tenant\": tenant, \"key\": key, \"sku\": sku, \"qty\": qty}\n         self.cache.put(tenant, key, {\"sku\": sku, \"qty\": qty, \"released\": False, \"response\": response})\n         return response.copy()", "source_sha256": "4c13050e5ae597f77411b94dff1dcf5dc5044843b3697b497b067b068e581bdb"}, "previous": "fef731dc3ea20f6c26970cb6e2487740d2d498872960b6a8c171a6ce0cd94e5d", "sha256": "87c541da919a94dbec203ec170c6c014e8813c43fefed338ef11f202cb62110c"}
